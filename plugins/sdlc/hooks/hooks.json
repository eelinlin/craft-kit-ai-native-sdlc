{
  "description": "Team SDLC gates. Changes need standards owner + tech lead approval (GOVERNANCE.md).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/session-context.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/protect-paths.sh" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/protect-tests.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/release-gate.sh" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/require-artifacts.sh" }
        ]
      }
    ]
  }
}
